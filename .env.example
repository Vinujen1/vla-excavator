# Copy to .env (git-ignored) and fill in. Never commit real tokens.
# Generate a token:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# ---- Jetson console ---------------------------------------------------
# Raspberry Pi motion service. For simulation on the Jetson itself, scripts/start_sim_pi.sh
# listens on 127.0.0.1:8100. For the real Pi use its private Wi-Fi address.
VLA_PI_ENDPOINT=http://127.0.0.1:8100
VLA_PI_API_TOKEN=change-me-to-a-long-random-token

# Cosmos 3 reasoner on a separate, supported GPU host (OpenAI-compatible API). Leave the
# base URL empty until a server is actually running; the console then reports "not connected".
#   vLLM:  vllm serve nvidia/Cosmos3-Edge ...      -> VLA_COSMOS_MODEL=nvidia/Cosmos3-Edge
#   NIM:   nvcr.io/nim/nvidia/cosmos3-reasoner     -> VLA_COSMOS_MODEL=nvidia/cosmos3-nano-reasoner
VLA_COSMOS_BASE_URL=
VLA_COSMOS_MODEL=nvidia/Cosmos3-Edge
VLA_COSMOS_API_KEY=
VLA_COSMOS_TIMEOUT_S=30
# "", "true" or "false": sends chat_template_kwargs.enable_thinking (vLLM). Leave empty for NIM.
VLA_COSMOS_ENABLE_THINKING=

# Task limits
VLA_MAX_CYCLES=5
VLA_TASK_TIMEOUT_S=300

# ---- Simulated Pi (scripts/start_sim_pi.sh) -----------------------------
PI_BACKEND=simulation
PI_HOST=127.0.0.1
PI_PORT=8100
# The Pi service reads PI_API_TOKEN; the start script copies VLA_PI_API_TOKEN into it.
